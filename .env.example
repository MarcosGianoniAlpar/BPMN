# Copie para .env e preencha. NUNCA versione o .env real.

# Chave da API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado na extracao. Sonnet 5 e o padrao: melhor custo/qualidade para
# extracao estruturada e ~3x mais barato que o Fable com o mesmo saldo.
# Alternativas para comparar: claude-fable-5 (mais caro), claude-opus-4-8
ANTHROPIC_MODEL=claude-sonnet-5

# Limite de tokens de saida na extracao.
# NAO passe de 21333: acima disso o SDK recusa a chamada nao-streaming na hora
# ("Streaming is required for operations that may take longer than 10 minutes").
MAX_OUTPUT_TOKENS=20000

# Teto de chamadas de IA (a app e publica: sem isto, quem tem a URL gasta a
# verba da empresa). 0 desliga o limite correspondente.
#   por visitante, por hora  — contem o abuso de um usuario
RATE_LIMIT_PER_IP_HOUR=20
#   da aplicacao inteira, por dia — e este que poe teto na FATURA
RATE_LIMIT_GLOBAL_PER_DAY=150

# Banco Postgres (Supabase). Use a connection string do POOLER (Transaction),
# porta 6543 — necessaria em serverless (Vercel). Em:
#   Supabase > Project Settings > Database > Connection pooling > "Transaction"
# Formato: postgresql://postgres.<ref>:<senha>@aws-...pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
