# Copie para .env e preencha. NUNCA versione o .env real.

# Chave da API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado na extracao. Sonnet 5 e o padrao: melhor custo/qualidade para
# extracao estruturada e ~3x mais barato que o Fable com o mesmo saldo.
# Alternativas para comparar: claude-fable-5 (mais caro), claude-opus-4-8
ANTHROPIC_MODEL=claude-sonnet-5

# Limite de tokens de saida na extracao.
# O maximo do Sonnet 5 e 128000. O antigo teto de 21333 era do SDK numa chamada
# nao-streaming; as chamadas agora usam streaming, entao ele nao vale mais.
# 64000 e a metade, de proposito: mais tokens = chamada mais LENTA (~130/s), e o
# Vercel Hobby corta em 60s. Documento grande roda local.
MAX_OUTPUT_TOKENS=64000

# Raciocinio do modelo nas 3 chamadas de IA. Valores: disabled | adaptive.
# (O modo antigo "enabled"/budget_tokens foi REMOVIDO no Sonnet 5 e devolve 400.)
#
#   disabled  — padrao. Mais barato e mais rapido. Mas a referencia da API diz
#               que com o thinking desligado o Sonnet 5 puxa MENOS as
#               ferramentas, e as duas falhas com a ata de PO (o array `nodes`
#               vindo como string dentro do tool_use) sao dessa familia.
#   adaptive  — o modelo decide quanto pensar. Os tokens de raciocinio contam no
#               MAX_OUTPUT_TOKENS e na FATURA, e vem invisiveis (o `display`
#               padrao e "omitted"). Tambem deixa a chamada mais lenta, o que
#               aproxima do teto de 60s do Vercel Hobby.
#
# Existe como flag porque decidir entre os dois custa duas geracoes pagas.
AI_THINKING=disabled

# Quanto o modelo se esforca (pensa E age) nas 3 chamadas.
# Valores: low | medium | high | xhigh | max.
#
# high e o PADRAO DA API — ou seja, e o que este projeto pagou por OMISSAO em
# todas as chamadas ate a versao do SDK que trouxe este campo. Mantido como padrao
# aqui de proposito, para que subir o SDK nao mude a fatura em silencio.
#
# A escala desceu um degrau com o Sonnet 5: pela referencia da API, `medium` no
# Sonnet 5 rende aproximadamente o que o Sonnet 4.6 rendia em `high`. Entao
# `medium` e o primeiro lugar para procurar economia — 1 geracao decide.
# `xhigh`/`max` sao para o caso oposto: extracao dificil onde acertar vale mais
# que o custo. Cuidado: mais esforco = chamada mais lenta = mais perto dos 60s do
# Vercel Hobby.
AI_EFFORT=high

# Teto de chamadas de IA (a app e publica: sem isto, quem tem a URL gasta a
# verba da empresa). 0 desliga o limite correspondente.
#   por visitante, por hora  — contem o abuso de um usuario
RATE_LIMIT_PER_IP_HOUR=20
#   da aplicacao inteira, por dia — e este que poe teto na FATURA
RATE_LIMIT_GLOBAL_PER_DAY=150

# Banco Postgres (Supabase). Use a connection string do POOLER (Transaction),
# porta 6543 — necessaria em serverless (Vercel). Em:
#   Supabase > Project Settings > Database > Connection pooling > "Transaction"
# Formato: postgresql://postgres.<ref>:<senha>@aws-...pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Opcional — conexao usada so por `npm run backup`. O pg_dump NAO opera no pooler
# de transacao (6543); o script ja troca sozinho para 5432 (pooler de sessao),
# entao so preencha se o backup precisar sair de outro lugar.
# BACKUP_DATABASE_URL=postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
