{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{node_modules/@napi-rs/canvas*/**,node_modules/pdfjs-dist/legacy/build/**,node_modules/pdfjs-dist/standard_fonts/**,schemas/**,prompts/**}"
    }
  }
}
