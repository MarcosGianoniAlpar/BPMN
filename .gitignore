# Dependencias
node_modules/

# Build
dist/

# Assets do bpmn-js copiados no build (gerados por scripts/copy-vendor.mjs)
public/vendor/

# Diretorio local do Vercel CLI
.vercel/

# Ambiente / segredos
.env
.env.local

# Saidas geradas
output/*
!output/.gitkeep

# Banco de dados local (persistencia de projetos/versoes)
data/

# Dumps do banco (npm run backup) — contem dados de processos da empresa
backups/

# Relatorios de avaliacao gerados
evaluations/reports/

# Documentos reais de teste (confidenciais)
test-documents/*
!test-documents/.gitkeep
!test-documents/README.md
!test-documents/exemplo-*.md

# Logs e SO
*.log
.DS_Store
Thumbs.db
