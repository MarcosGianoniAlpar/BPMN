{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://alpar.local/schemas/process-spec.schema.json",
  "title": "ProcessSpec",
  "description": "Modelo intermediario entre a LLM e a geracao de BPMN. A LLM produz este objeto; o compilador deterministico o transforma em BPMN 2.0. Escopo Fase 1 (MVP).",
  "type": "object",
  "additionalProperties": false,
  "required": ["process", "nodes", "flows"],
  "properties": {
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "participants": {
      "type": "array",
      "description": "Organizacoes envolvidas. Na Fase 1, organizacoes externas viram pool caixa-preta.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["internal", "external"] }
        }
      }
    },
    "lanes": {
      "type": "array",
      "description": "Raias (departamentos/papeis) dentro de um participante.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "participant_id": { "$ref": "#/$defs/id" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": {
            "type": "string",
            "description": "Tipos suportados na Fase 1.",
            "enum": [
              "start_event",
              "end_event",
              "user_task",
              "service_task",
              "exclusive_gateway"
            ]
          },
          "name": { "type": "string" },
          "lane_id": { "$ref": "#/$defs/id" },
          "evidence": {
            "type": "array",
            "description": "De onde no documento este no foi extraido. Obrigatorio para nos gerados pela IA.",
            "items": { "$ref": "#/$defs/evidence" }
          },
          "confidence": { "$ref": "#/$defs/confidence" }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "target"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source": { "$ref": "#/$defs/id" },
          "target": { "$ref": "#/$defs/id" },
          "name": {
            "type": "string",
            "description": "Rotulo do fluxo, ex.: 'Sim' / 'Nao' na saida de um gateway."
          },
          "condition": {
            "type": "string",
            "description": "Condicao textual. Obrigatoria em saidas de exclusive_gateway."
          }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "description": "Ambiguidades que o documento nao resolveu. A IA nunca deve inventar o fluxo; deve perguntar.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string" },
          "affected_nodes": {
            "type": "array",
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Identificador estavel, seguro para virar ID BPMN."
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote"],
      "properties": {
        "quote": {
          "type": "string",
          "description": "Trecho literal do documento que sustenta o elemento."
        },
        "document_id": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 },
        "chunk_id": {
          "type": "string",
          "description": "Reservado para a Fase 2 (chunking). Na Fase 1 pode ficar ausente."
        }
      }
    }
  }
}
