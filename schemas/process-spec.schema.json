{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://alpar.local/schemas/process-spec.schema.json",
  "title": "ProcessSpec",
  "description": "Modelo intermediario entre a LLM e a geracao de BPMN. A LLM produz este objeto; o compilador deterministico o transforma em BPMN 2.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["process", "nodes", "flows"],
  "properties": {
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "participants": {
      "type": "array",
      "description": "Organizacoes envolvidas. Organizacoes externas viram pool caixa-preta.",
      "items": { "$ref": "#/$defs/participant" }
    },
    "lanes": {
      "type": "array",
      "description": "Raias (departamentos/papeis) dentro de um participante.",
      "items": { "$ref": "#/$defs/lane" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/processNode" }
    },
    "flows": {
      "type": "array",
      "items": { "$ref": "#/$defs/flow" }
    },
    "unresolved_questions": {
      "type": "array",
      "description": "Ambiguidades que o documento nao resolveu. A IA nunca deve inventar o fluxo; deve perguntar.",
      "items": { "$ref": "#/$defs/unresolvedQuestion" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Identificador estavel, seguro para virar ID BPMN."
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote"],
      "properties": {
        "quote": {
          "type": "string",
          "description": "Trecho literal do documento que sustenta o elemento."
        },
        "document_id": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 },
        "chunk_id": {
          "type": "string",
          "description": "Reservado para a Fase 2 (chunking). Na Fase 1 pode ficar ausente."
        }
      }
    },
    "nodeType": {
      "type": "string",
      "description": "Gateways: exclusive = caminhos alternativos (so um segue); parallel = caminhos simultaneos (todos seguem, saidas sem condicao). Eventos intermediarios: timer_event = espera por tempo; message_event = espera por mensagem/resposta externa.",
      "enum": [
        "start_event",
        "end_event",
        "user_task",
        "service_task",
        "exclusive_gateway",
        "parallel_gateway",
        "timer_event",
        "message_event"
      ]
    },
    "processNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/nodeType" },
        "name": { "type": "string" },
        "lane_id": { "$ref": "#/$defs/id" },
        "evidence": {
          "type": "array",
          "description": "De onde no documento este no foi extraido. Obrigatorio para nos gerados pela IA.",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "name": {
          "type": "string",
          "description": "Rotulo do fluxo, ex.: 'Sim' / 'Nao' na saida de um gateway."
        },
        "condition": {
          "type": "string",
          "description": "Condicao textual. Obrigatoria em saidas de exclusive_gateway."
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["internal", "external"] }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "participant_id": { "$ref": "#/$defs/id" }
      }
    },
    "unresolvedQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "question": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" },
        "affected_nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
